# VigiWatch web app — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_ and never import into
# client-side code. Used only in Server Components, Route Handlers, and
# Server Actions for operations that require elevated privileges.
SUPABASE_SERVICE_ROLE_KEY=
