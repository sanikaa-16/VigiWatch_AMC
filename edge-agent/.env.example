# VigiWatch Edge Agent — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# This process runs on-premise inside the customer's network — none of these
# values are ever exposed to the browser or the cloud app's client code.

# VigiWatch cloud endpoint this agent reports health data to.
VIGIWATCH_CLOUD_API_URL=

# Credential the agent uses to authenticate itself to the VigiWatch cloud.
VIGIWATCH_AGENT_TOKEN=

# Identifies which customer site this agent instance is deployed at.
VIGIWATCH_SITE_ID=
